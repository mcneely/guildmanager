{
  "name": "mcneely/guildmanager",
  "description": "Modular single-server Discord bot: voice-wait, onboarding, and overflow modules",
  "type": "project",
  "license": "MIT",
  "homepage": "https://github.com/mcneely/guildmanager",
  "authors": [
    {
      "name": "Paul L. McNeely",
      "email": "paul@paulmcneely.com",
      "homepage": "http://paulmcneely.com"
    }
  ],
  "require": {
    "php": ">=8.5.12",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-zlib": "*",
    "psr/log": "^3.0",
    "react/http": "^1.11.1",
    "react/promise": "^3.3",
    "symfony/console": "^8.1",
    "team-reflex/discord-php": "^10.66.1"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/App/",
      "Module\\": "src/Modules/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --do-not-record-test-run-history",
    "lint": "@php tools/lint.php",
    "analyse": "phpstan analyse",
    "cs:check": "php-cs-fixer fix --dry-run --diff",
    "cs:fix": "php-cs-fixer fix",
    "rector": "rector process",
    "infection": "infection"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    },
    "sort-packages": true
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.95",
    "infection/infection": "^0.35",
    "phpat/phpat": "^0.12",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^13",
    "rector/rector": "^2.7"
  }
}
